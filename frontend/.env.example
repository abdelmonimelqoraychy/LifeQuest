# Public configuration only. Copy to .env.local; never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_ORIGIN=http://127.0.0.1:3000
# RPC architecture: no PostgreSQL password or service_role in the Next runtime.
