# Configuration template. Keep .env.local ignored; never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
APP_ORIGIN=http://127.0.0.1:3000
# Server only: generate 48 random bytes as hex locally. Never use NEXT_PUBLIC.
AUTH_RECOVERY_SECRET=replace-with-a-server-only-random-signing-key
# RPC architecture: no PostgreSQL password or service_role in the Next runtime.
